        android:pathData="M 14.5,12 L 24.5,12 A 1.5,1.5 0 0 1 26,13.5 L 26,21.5 A 1.5,1.5 0 0 1 24.5,23 L 14.5,23 A 1.5,1.5 0 0 1 13,21.5 L 13,13.5 A 1.5,1.5 0 0 1 14.5,12 Z" />
