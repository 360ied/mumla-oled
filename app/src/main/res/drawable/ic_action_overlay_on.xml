    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.8"
        android:strokeLineCap="round"
        android:pathData="M 16,16 L 23,16 M 16,19.5 L 20,19.5" />
