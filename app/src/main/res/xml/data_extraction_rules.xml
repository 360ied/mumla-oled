<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- H8: same secret files as backup_rules.xml. Required on API 31+
             (targetSdk 36); fullBackupContent alone no longer applies. -->
        <exclude domain="database" path="mumble.db" />
        <exclude domain="database" path="mumble.db-journal" />
        <exclude domain="database" path="mumble.db-shm" />
        <exclude domain="database" path="mumble.db-wal" />
        <exclude domain="file" path="mumla-store.bks" />
    </cloud-backup>
    <device-transfer>
        <!-- Same secret files: D2D restore must not carry identities either. -->
        <exclude domain="database" path="mumble.db" />
        <exclude domain="database" path="mumble.db-journal" />
        <exclude domain="database" path="mumble.db-shm" />
        <exclude domain="database" path="mumble.db-wal" />
        <exclude domain="file" path="mumla-store.bks" />
    </device-transfer>
</data-extraction-rules>
