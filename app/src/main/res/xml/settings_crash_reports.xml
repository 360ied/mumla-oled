<!-- app: namespace for key/title/summary/fragment to match preference_headers.xml. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        app:key="crash_list_category"
        app:title="@string/crash_reports"
        app:iconSpaceReserved="false">
    </PreferenceCategory>
    <Preference
        app:key="crash_delete_all"
        app:title="@string/crash_delete_all"
        app:iconSpaceReserved="false" />
    <PreferenceCategory
        app:key="crash_test"
        app:title="@string/crash_test"
        app:iconSpaceReserved="false">
        <Preference
            app:key="crash_test_java"
            app:title="@string/crash_test_java"
            app:summary="@string/crash_test_summary"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="crash_test_native"
            app:title="@string/crash_test_native"
            app:summary="@string/crash_test_summary"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="crash_test_anr"
            app:title="@string/crash_test_anr"
            app:summary="@string/crash_test_summary"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
